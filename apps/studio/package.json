{
  "name": "@asa/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI shell de Architecture Studio AI (editor 3D, simulación, inspector, consola).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@asa/core-model": "workspace:*",
    "@asa/simulation-engine": "workspace:*",
    "@asa/visualization-3d": "workspace:*",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.8"
  }
}
