{
  "name": "architecture-studio-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Laboratorio 3D de arquitecturas de solución con simulación determinista",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @asa/studio dev",
    "build": "pnpm --filter @asa/studio build",
    "preview": "pnpm --filter @asa/studio preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @asa/studio e2e",
    "sim": "pnpm --filter @asa/simulation-engine sim",
    "ci": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
